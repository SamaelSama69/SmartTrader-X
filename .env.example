# ─────────────────────────────────────────────────────────────────────────────
# SmartTrader — Environment Variables
# Copy this file to .env and fill in your keys.
# ALL keys are optional — the system degrades gracefully to available sources.
# ─────────────────────────────────────────────────────────────────────────────

# ── NEWS & SOCIAL SENTIMENT ───────────────────────────────────────────────────
# News API — global news sentiment (free: 100 req/day)
# Get key: https://newsapi.org/register
NEWS_API_KEY=

# Reddit API — social sentiment from r/wallstreetbets, r/IndiaInvestments
# Get key: https://www.reddit.com/prefs/apps → "create another app" → script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SmartTrader/2.0 (by your_reddit_username)

# Finnhub — pre-computed Reddit + Twitter sentiment (free: 60 calls/min)
# Get key: https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage — additional fundamental data (free: 25 req/day)
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# ── BROKER INTEGRATION (Indian Markets) ───────────────────────────────────────
# Shoonya (Finvasia) — THE BEST FREE API (Zero Brokerage, Zero API Fees)
# Get keys: https://prism.finvasia.com/
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_KEY=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=abc1234

# Zerodha Kite Connect — live NSE/BSE data and order placement
# Get keys: https://kite.zerodha.com/api (requires Kite Connect subscription ~₹2000/mo)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=    # Regenerated daily — see AUTO_TRADING_GUIDE.md

# ── NOTIFICATIONS ─────────────────────────────────────────────────────────────
# Telegram bot alerts — free, instant mobile alerts (RECOMMENDED)
# Setup: Message @BotFather on Telegram → /newbot → copy token
# Get Chat ID: Message @userinfobot on Telegram → copy id number
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (optional — SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=     # Use an App Password for Gmail, not your real password

# ── SYSTEM SETTINGS ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
MAX_TICKERS_TO_ANALYZE=10       # Max tickers per screening cycle
INITIAL_CAPITAL=100000          # Paper trading starting capital (INR)
MAX_POSITION_PCT=0.10           # Max 10% of capital in one position
STOP_LOSS_ATR_MULTIPLIER=2.0    # ATR-based stop loss multiplier
TAKE_PROFIT_RR_RATIO=2.0        # Reward-to-risk ratio (2.0 = 2:1 target)
MAX_DRAWDOWN_PCT=0.20           # Kill-switch: pause if drawdown > 20%
CONFIDENCE_THRESHOLD=0.70       # Min signal confidence to execute a trade

# ── TRADING MODE ──────────────────────────────────────────────────────────────
# These are overridden by --paper / --live CLI flags
# PAPER_TRADE=true               # true = simulate orders (safe default)
# AUTO_TRADE=false               # false = never place real orders without --live flag

# ── INDIAN MOMENTUM STRATEGY SETTINGS ──────────────────────────────────────────
ENABLE_AUTO_TRADING=false        # Global toggle for automated execution
NIFTY_EMA_PERIOD=200             # Bull market filter period (Nifty 50)
MOMENTUM_WINDOW_SHORT=90         # Days for short-term momentum calculation
MOMENTUM_WINDOW_LONG=180         # Days for long-term momentum calculation
SECTOR_EXPOSURE_LIMIT=0.30       # Max 30% exposure per sector
VCP_CONTRACTION_WEEKS=4          # Weeks to look for price tightening
PORTFOLIO_STOP_LOSS_DAILY=0.03   # Max 3% daily portfolio loss
MAX_OPEN_POSITIONS=10            # Max 10 concurrent trades
